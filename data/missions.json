{
 "_about": "Every PamProgressionMission (vtable 0x141C8E658; +0x10 name, +0x40 MissionIndex, +0x48 CompletedFlag, +0x50 AvailableFlag, +0xB0 MissionType), read from memory 2026-11-22, Steam build. The game computes Available itself at each checkpoint reload (Available = offered now) and writes it through the +0x50 pointer. The activity lock (docs/DLL.md section 11f): point +0x48 at a flag that is 1 and the game treats the activity as done (Available 0, off the map), while its real completion flag is untouched. Not for the Dead Drop Deliveries (OWPh<N>Delivery01-03): the game always offers one per phase.",
 "mission_types": {
  "0": "CompletedFlag DebugGenerated_*: mostly test or cut content",
  "1": "opportunity (MiscCompleted_*)",
  "2": "bronze: deliveries, security hubs and a few others (BronzeCompleted_*)",
  "3": "side mission (SilverCompleted_*)",
  "4": "story (GoldCompleted_*)"
 },
